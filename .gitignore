# ZionPattern Solver - .gitignore
# Local-first, privacy-respecting defaults

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# sdist tarballs only — do NOT ignore workers/**/public/*.tar.gz
# (the download-tracker hosts the public asset from that folder)
dist/*.tar.gz

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Project-specific (generated receipts stay local)
receipts/*.json
!receipts/.gitkeep
*.log
*.tmp
output/
temp/

# Large binaries or sealed artifacts (keep local)
*.zip
large_assets/

# Worker / packaging noise
node_modules/
.wrangler/
workers/download-tracker/node_modules/
workers/download-tracker/.wrangler/
